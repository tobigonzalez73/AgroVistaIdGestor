# Establece el comportamiento predeterminado para que Git maneje los finales de línea automáticamente.
# Normalizará todos los archivos de texto a LF en el repositorio.
* text=auto eol=lf

# Archivos que deben tener siempre finales de línea LF (Linux/macOS).
*.js eol=lf
*.jsx eol=lf
*.ts eol=lf
*.tsx eol=lf
*.mjs eol=lf
*.css eol=lf
*.html eol=lf
*.json eol=lf
*.md eol=lf
*.sh eol=lf

# Archivos binarios que Git no debe modificar nunca.
*.jpg binary
*.png binary
*.ico binary